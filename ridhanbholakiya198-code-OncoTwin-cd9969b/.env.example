# Public Firebase web-app configuration (safe to expose to the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets. Never prefix these with VITE_.
GEMINI_API_KEY=

# Required in production when using Firestore Admin transactions.
# Store the service-account JSON as a Vercel Environment Variable.
FIREBASE_SERVICE_ACCOUNT=

# Optional shared-provider selection.
DEFAULT_AI_PROVIDER=gemini
